// Simulation.compute
// Basic compute kernels for iteration 0 (skeleton implementations).

#pragma kernel DiffuseEnergyKernel
#pragma kernel ApplySoilChange
#pragma kernel LeafKernel
#pragma kernel RootKernel
#pragma kernel AntennaKernel
#pragma kernel RerouteKernel
#pragma kernel TransportKernel
#pragma kernel AbsorptionKernel
#pragma kernel DeathKernel
#pragma kernel SeedKernel
// #pragma kernel BehaviorKernel
#pragma kernel StatsKernel

#include "Defines.hlsl"
#include "CommonParams.hlsl"

RWStructuredBuffer<uint> _Stats; // small stats buffer

#include "Common.hlsl"
// #include "CellBehavior.hlsl"

[numthreads(8,8,1)]
void DiffuseEnergyKernel(uint3 id : SV_DispatchThreadID)
{
    int2 pos = int2(id.x, id.y);
    if (pos.x >= _Width || pos.y >= _Height) return;

    float2 cur = _SoilTexRead[pos];
    // float2 next = lerp(cur, avg, saturate(_DiffusionRate));
    // next.x = cur.x;

    float2 next = float2(cur.x, lerp(cur.y, 1.0, _DiffusionRate * _Timestep));
    _SoilTexWrite[pos] = next;
}

[numthreads(8,8,1)]
void ApplySoilChange(uint3 id: SV_DispatchThreadID)
{
    _SoilTexRead[id.xy] = _SoilTexWrite[id.xy];
}

