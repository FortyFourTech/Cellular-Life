[numthreads(8,8,1)]
void LeafKernel(uint3 id : SV_DispatchThreadID)
{
    uint cellIdx = PosToIdx(id.xy);
    Cell c = _Cells[cellIdx];
    if (c.cellType != CELLTYPE_LEAF) return; // only leaves

    int2 pos = id.xy;
    float2 soil = _SoilTexRead[pos];
    float localOrganics = soil.x;
    // production formula (MVP): proportional to local organics and sunlight
    float produced = saturate(localOrganics) * _Sunlight * 0.01;
    c.energy += produced * _Timestep;
    _Cells[cellIdx] = c;
}

[numthreads(8,8,1)]
void RootKernel(uint3 id : SV_DispatchThreadID)
{
    uint cellIdx = PosToIdx(id.xy);
    uint cellType = _Cells[cellIdx].cellType;
    if (cellType != CELLTYPE_ROOT) return; // only roots

    int2 pos = id.xy;
    float2 soil = _SoilTexRead[pos];
    float localOrganics = soil.x;
    float produced = min(localOrganics, ABSORB_SOIL_ORGANICS * _Timestep);
    _Cells[cellIdx].energy += produced;
    _SoilTexWrite[pos] = float2(soil.x - produced, soil.y); // deplete organics
}

[numthreads(8,8,1)]
void AntennaKernel(uint3 id : SV_DispatchThreadID)
{
    uint cellIdx = PosToIdx(id.xy);
    uint cellType = _Cells[cellIdx].cellType;
    if (cellType != CELLTYPE_ANTENNA) return; // only antennas

    int2 pos = id.xy;
    float2 soil = _SoilTexRead[pos];
    float localEnergy = soil.y;
    float produced = min(localEnergy, ABSORB_SOIL_ENERGY * _Timestep);
    _Cells[cellIdx].energy += produced;
    _SoilTexWrite[pos] = float2(soil.x, soil.y - produced); // deplete energy
}

[numthreads(8,8,1)]
void RerouteKernel(uint3 id : SV_DispatchThreadID)
{
    uint cellIdx = PosToIdx(id.xy);

    Cell c = _Cells[cellIdx];
    if (c.cellType != CELLTYPE_WOOD || c.energyFlow > 0 || c.parentDir == 0xffffffff) return; // only wood

    SetIntBit(c.energyFlow, 1, c.parentDir);
    uint2 parentPos = ShiftCoord(id.xy, c.parentDir);
    uint parentIdx = PosToIdx(parentPos);
    SetIntBit(_Cells[parentIdx].energyFlow, 0, RotateDir(c.parentDir, DIR_B));

    _Cells[cellIdx] = c;
}

[numthreads(8,8,1)]
void TransportKernel(uint3 id : SV_DispatchThreadID)
{
    uint2 cellPos = id.xy;
    uint cellIdx = PosToIdx(cellPos);
    uint cellType = _Cells[cellIdx].cellType;
    if (cellType == 0 || cellType >=  CELLTYPE_SPROUT) return; // only wood and factories transfers energy

    for (uint dir = 0; dir < 4; ++dir) {
        uint2 neighborPos = ShiftCoord(cellPos, dir);
        uint neighborIdx = PosToIdx(neighborPos);
        if (_Cells[neighborIdx].cellType == 0) continue;

        float transformDelta = GetIntBit(_Cells[cellIdx].energyFlow, dir) * max(_Cells[cellIdx].energy - _Cells[neighborIdx].energy, 0) * TRANSPORT_SPEED * _Timestep;
        _Cells[cellIdx].energy -= transformDelta;
        _Cells[neighborIdx].energy += transformDelta;
    }
}

[numthreads(8,8,1)]
void AbsorptionKernel(uint3 id : SV_DispatchThreadID)
{
    uint cellIdx = PosToIdx(id.xy);
    Cell cell = _Cells[cellIdx];
    if (cell.cellType == 0) return;

    float cost = (cell.cellType == CELLTYPE_SEED ? ABSORB_LIFE_ENERGY_SEED : ABSORB_LIFE_ENERGY) * _Timestep;
    cell.energy -= cost;
    _Cells[cellIdx] = cell;
}

[numthreads(8,8,1)]
void DeathKernel(uint3 id : SV_DispatchThreadID)
{
    uint2 cellPos = id.xy;
    uint cellIdx = PosToIdx(cellPos);
    Cell c = _Cells[cellIdx];
    uint cellType = c.cellType;
    float2 soil = _SoilTexRead[cellPos];
    if (cellType > 0
        && (c.energy <= 0.0
            || (cellType == CELLTYPE_ROOT && soil.x <= 0)
            || (cellType == CELLTYPE_ANTENNA && soil.y <= 0)
            || (cellType != CELLTYPE_ROOT && soil.x > _CriticalOrg)
            || (cellType != CELLTYPE_ANTENNA && soil.y > _CriticalNrg)
            || (cellType < CELLTYPE_SPROUT && !IsCellSendEnergy(cellPos, c) && IsCellSingle(cellPos, c))
            // || (c.cellType == CELLTYPE_WOOD && c.flowDirs = 0)
        )
    ) {
        KillCell(cellPos);
    }
}

[numthreads(8,8,1)]
void SeedKernel(uint3 id : SV_DispatchThreadID)
{
    uint2 cellPos = id.xy;
    uint cellIdx = PosToIdx(cellPos);
    Cell cell = _Cells[cellIdx];
    if (cell.cellType != CELLTYPE_SEED) return; // only seeds

    uint seedTimer = UnpackInt1(cell.seedProps);

    // move if single
    [branch]
    if (seedTimer == 255u) {
        ConvertToSprout(cellPos);
    } else {
        // deplete timer
        --seedTimer;
        SetIntByte(cell.seedProps, seedTimer, 0);

        bool isSingle = IsCellSingle(cellPos, cell);
        uint seedSpeed = UnpackInt3(cell.seedProps);

        [branch]
        if (isSingle) {
            [branch]
            if (seedSpeed > 0) {
                // Move seed
                uint moveDir = cell.direction;
                uint2 targetCoord = ShiftCoord(cellPos, moveDir);
                uint targetIdx = PosToIdx(targetCoord);

                [branch]
                if (_Cells[targetIdx].cellType > 0) {
                    // kill target cell and self
                    KillCell(targetCoord);
                    KillCell(cellPos);
                } else {
                    // copy self in movement direction
                    cell.seedProps = 47;
                    _Cells[targetIdx] = cell;

                    // erase self in current position
                    _Cells[cellIdx] = (Cell)0;
                }
            } else {
                cell.seedProps = 50;
                _Cells[cellIdx] = cell;
            }
        } else {
            cell.seedProps = 52;
            _Cells[cellIdx] = cell;
        }
    }
}

