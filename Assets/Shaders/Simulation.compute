[numthreads(8,8,1)]
void StatsKernel(uint3 id : SV_DispatchThreadID)
{
    uint cellIdx = PosToIdx(id.xy);
    Cell c = _Cells[cellIdx];
    // InterlockedAdd(_Stats[0], 1);
    InterlockedAdd(_Stats[0], c.cellType != 0 ? 1 : 0);
    InterlockedAdd(_Stats[1], c.cellType == CELLTYPE_LEAF ? 1 : 0);
    // _Stats[0] = totalCells;
    // _Stats[1] = leafCount;
}
