[numthreads(8,8,1)]
void LeafKernel(uint3 id : SV_DispatchThreadID)
{
    uint2 cellPos = id.xy;
    uint cellIdx = PosToIdx(cellPos);
    Cell cell = _Cells[cellIdx];
    if (cell.cellType != CELLTYPE_LEAF) return; // only leaves

    float organicsLocal = 0.0;
    float organicsNeighbors = 0.0;
    // uint freeSpace = 0; // TODO: consider free space around the leaf
    uint2 mapSize = uint2(_Width,_Height);
    for (int dx = -1; dx <= 1; ++dx) {
        for (int dy = -1; dy <= 1; ++dy) {
            uint2 coord = (cellPos + uint2(dx,dy) + mapSize) % mapSize;
            float2 soil = _SoilTexRead[coord];
            organicsLocal += soil.x * (dx == 0 && dy == 0);
            organicsNeighbors += soil.x * (1 - (dx == 0 && dy == 0));
            // uint coordIdx = PosToIdx(coord);
            // freeSpace += _Cells[coordIdx].cellType == 0; // TODO: consider free space around the leaf
        }
    }
    float organicsAround = organicsLocal + (organicsNeighbors * 0.125);
    float produced = organicsAround * _Sunlight * _Timestep;
    // float produced = organicsAround * ((float)freeSpace / 7.0) * _Sunlight * _Timestep; // TODO: consider free space around the leaf
    cell.energy += produced * _Timestep;
    _Cells[cellIdx] = cell;
}

[numthreads(8,8,1)]
void RootKernel(uint3 id : SV_DispatchThreadID)
{
    uint2 cellPos = id.xy;
    uint cellIdx = PosToIdx(cellPos);
    uint cellType = _Cells[cellIdx].cellType;
    if (cellType != CELLTYPE_ROOT) return; // only roots

    float collectedNrg = 0.0;
    float localOrganics = 0.0;
    // uint freeSpace = 0; // TODO: consider free space around the leaf
    uint2 mapSize = uint2(_Width,_Height);
    for (int dx = -1; dx <= 1; ++dx) {
        for (int dy = -1; dy <= 1; ++dy) {
            uint2 coord = (cellPos + uint2(dx,dy) + mapSize) % mapSize;
            float2 soil = _SoilTexRead[coord];
            float coordOrganics = soil.x * (dx == 0 && dy == 0 ? 1.0 : 0.125);
            localOrganics += soil.x * (dx == 0 && dy == 0);
            float delta = min(coordOrganics, ABSORB_SOIL_ORGANICS * _Timestep);
            collectedNrg += delta;
            localOrganics -= delta * (dx == 0 && dy == 0);
            _SoilTexWrite[coord] = float2(soil.x - delta, soil.y); // deplete organics
        }
    }

    _Cells[cellIdx].energy += collectedNrg;

    if (localOrganics <= 0) ConvertToWood(cellPos);
}

[numthreads(8,8,1)]
void AntennaKernel(uint3 id : SV_DispatchThreadID)
{
    uint2 cellPos = id.xy;
    uint cellIdx = PosToIdx(cellPos);
    uint cellType = _Cells[cellIdx].cellType;
    if (cellType != CELLTYPE_ANTENNA) return; // only antennas

    float collectedNrg = 0.0;
    float localEnergy = 0.0;
    // uint freeSpace = 0; // TODO: consider free space around the leaf
    uint2 mapSize = uint2(_Width,_Height);
    for (int dx = -1; dx <= 1; ++dx) {
        for (int dy = -1; dy <= 1; ++dy) {
            uint2 coord = (cellPos + uint2(dx,dy) + mapSize) % mapSize;
            float2 soil = _SoilTexRead[coord];
            float coordEnergy = soil.y * (dx == 0 && dy == 0 ? 1.0 : 0.125);
            localEnergy += soil.y * (dx == 0 && dy == 0);
            float delta = min(coordEnergy, ABSORB_SOIL_ORGANICS * _Timestep);
            collectedNrg += delta;
            localEnergy -= delta * (dx == 0 && dy == 0);
            _SoilTexWrite[coord] = float2(soil.x, soil.y - delta); // deplete energy
        }
    }

    _Cells[cellIdx].energy += collectedNrg;

    if (localEnergy <= 0) ConvertToWood(cellPos);
}

[numthreads(8,8,1)]
void RerouteKernel(uint3 id : SV_DispatchThreadID)
{
    uint cellIdx = PosToIdx(id.xy);

    Cell c = _Cells[cellIdx];
    if (c.cellType != CELLTYPE_WOOD || c.energyFlow > 0 || c.parentDir == 0xffffffff) return; // only wood

    SetIntBit(c.energyFlow, 1, c.parentDir);
    uint2 parentPos = ShiftCoord(id.xy, c.parentDir);
    uint parentIdx = PosToIdx(parentPos);
    SetIntBit(_Cells[parentIdx].energyFlow, 0, RotateDir(c.parentDir, DIR_B));

    _Cells[cellIdx] = c;
}

[numthreads(8,8,1)]
void TransportKernel(uint3 id : SV_DispatchThreadID)
{
    uint2 cellPos = id.xy;
    uint cellIdx = PosToIdx(cellPos);
    uint cellType = _Cells[cellIdx].cellType;
    if (cellType == 0 || cellType >=  CELLTYPE_SPROUT) return; // only wood and factories transfers energy

    for (uint dir = 0; dir < 4; ++dir) {
        uint2 neighborPos = ShiftCoord(cellPos, dir);
        uint neighborIdx = PosToIdx(neighborPos);
        if (_Cells[neighborIdx].cellType == 0) continue;

        float lowerBound = min(_Cells[neighborIdx].energy, 1.0);
        float transformDelta = GetIntBit(_Cells[cellIdx].energyFlow, dir) * max(_Cells[cellIdx].energy - lowerBound, 0) * TRANSPORT_SPEED * _Timestep;
        _Cells[cellIdx].energy -= transformDelta;
        _Cells[neighborIdx].energy += transformDelta;
    }
}

[numthreads(8,8,1)]
void AbsorptionKernel(uint3 id : SV_DispatchThreadID)
{
    uint cellIdx = PosToIdx(id.xy);
    Cell cell = _Cells[cellIdx];
    if (cell.cellType == 0) return;

    float cost = (cell.cellType == CELLTYPE_SEED ? ABSORB_LIFE_ENERGY_SEED : ABSORB_LIFE_ENERGY) * _Timestep;
    cell.energy -= cost;
    _Cells[cellIdx] = cell;
}

[numthreads(8,8,1)]
void DeathKernel(uint3 id : SV_DispatchThreadID)
{
    uint2 cellPos = id.xy;
    uint cellIdx = PosToIdx(cellPos);
    Cell c = _Cells[cellIdx];
    uint cellType = c.cellType;
    float2 soil = _SoilTexRead[cellPos];
    if (cellType > 0
        && (c.energy <= 0.0
            || (cellType != CELLTYPE_ROOT && soil.x > _CriticalOrg)
            || (cellType != CELLTYPE_ANTENNA && soil.y > _CriticalNrg)
            || (cellType < CELLTYPE_SPROUT && !IsCellSendEnergy(cellPos, c) && IsCellSingle(cellPos, c))
            // || (cellType == CELLTYPE_WOOD && c.flowDirs = 0)
        )
    ) {
        KillCell(cellPos);
    }
}

[numthreads(8,8,1)]
void SeedKernel(uint3 id : SV_DispatchThreadID)
{
    uint2 cellPos = id.xy;
    uint cellIdx = PosToIdx(cellPos);
    Cell cell = _Cells[cellIdx];
    if (cell.cellType != CELLTYPE_SEED) return; // only seeds

    uint seedTimer = UnpackInt1(cell.seedProps);

    // move if single
    [branch]
    if (seedTimer == 255u) {
        ConvertToSprout(cellPos);
    } else {
        // deplete timer
        --seedTimer;
        SetIntByte(cell.seedProps, seedTimer, 0);

        bool isSingle = IsCellSingle(cellPos, cell);
        uint seedSpeed = UnpackInt3(cell.seedProps);

        [branch]
        if (isSingle && seedSpeed > 0) {
            // Move seed
            uint moveDir = cell.direction;
            uint2 targetCoord = ShiftCoord(cellPos, moveDir);
            uint targetIdx = PosToIdx(targetCoord);

            [branch]
            if (_Cells[targetIdx].cellType > 0) {
                // kill target cell and self
                KillCell(targetCoord);
                KillCell(cellPos);
            } else {
                // copy self in movement direction
                _Cells[targetIdx] = cell;

                // erase self in current position
                _Cells[cellIdx] = (Cell)0;
            }
        } else {
            _Cells[cellIdx] = cell;
        }
    }
}

