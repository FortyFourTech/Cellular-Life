// Simulation.compute
// Basic compute kernels for iteration 0 (skeleton implementations).

#pragma kernel DiffuseEnergyKernel
#pragma kernel LeafKernel
#pragma kernel RootKernel
#pragma kernel AntennaKernel
#pragma kernel RerouteKernel
#pragma kernel TransportKernel
#pragma kernel AbsorptionKernel
#pragma kernel DeathKernel
#pragma kernel BehaviorKernel
#pragma kernel StatsKernel

#include "Defines.hlsl"
#include "CommonParams.hlsl"

cbuffer SimulationParams
{
    float _Sunlight;
    float _DiffusionRate;
    float _CriticalOrg;
    float _CriticalNrg;
};

RWStructuredBuffer<uint> _Stats; // small stats buffer

#include "Common.hlsl"
#include "CellBehavior.hlsl"

[numthreads(8,8,1)]
void DiffuseEnergyKernel(uint3 id : SV_DispatchThreadID)
{
    int2 pos = int2(id.x, id.y);
    if (pos.x >= _Width || pos.y >= _Height) return;

    // float2 sum = float2(0,0);
    // int count = 0;
    // for (int oy=-1; oy<=1; ++oy) {
    //     for (int ox=-1; ox<=1; ++ox) {
    //         int nx = (pos.x + ox + _Width) % _Width;
    //         int ny = (pos.y + oy + _Height) % _Height;
    //         float2 v = _SoilTexRead[int2(nx,ny)];
    //         sum += v;
    //         count++;
    //     }
    // }
    // float2 avg = sum / count;
    // // simple relaxation toward neighbor average controlled by diffusion rate
    float2 cur = _SoilTexRead[pos];
    // float2 next = lerp(cur, avg, saturate(_DiffusionRate));
    // next.x = cur.x;

    float2 next = float2(cur.x, lerp(cur.y, 0.5, 0.01));
    _SoilTexWrite[pos] = next;
}

[numthreads(32,32,1)]
void LeafKernel(uint3 id : SV_DispatchThreadID)
{
    uint cellIdx = PosToIdx(id.xy);
    Cell c = _Cells[cellIdx];
    if (c.cellType != CELLTYPE_LEAF) return; // only leaves

    int2 pos = id.xy;
    float2 soil = _SoilTexRead[pos];
    float localOrganics = soil.x;
    // production formula (MVP): proportional to local organics and sunlight
    float produced = saturate(localOrganics) * _Sunlight * 0.01;
    c.energy += produced * _Timestep;
    _Cells[cellIdx] = c;
}

[numthreads(32,32,1)]
void RootKernel(uint3 id : SV_DispatchThreadID)
{
    uint cellIdx = PosToIdx(id.xy);
    Cell c = _Cells[cellIdx];
    if (c.cellType != CELLTYPE_ROOT) return; // only roots

    int2 pos = id.xy;
    float2 soil = _SoilTexRead[pos];
    float localOrganics = soil.x;
    float produced = localOrganics * _Timestep;
    c.energy += produced;
    _Cells[cellIdx] = c;
    _SoilTexWrite[pos] = float2(soil.x - produced, soil.y); // deplete organics
}

[numthreads(32,32,1)]
void AntennaKernel(uint3 id : SV_DispatchThreadID)
{
    uint cellIdx = PosToIdx(id.xy);
    Cell c = _Cells[cellIdx];
    if (c.cellType != CELLTYPE_ANTENNA) return; // only antennas

    int2 pos = id.xy;
    float2 soil = _SoilTexRead[pos];
    float localEnergy = soil.y;
    float produced = localEnergy * _Timestep;
    c.energy += produced;
    _Cells[cellIdx] = c;
    _SoilTexWrite[pos] = float2(soil.x, soil.y - produced); // deplete energy
}

[numthreads(32,32,1)]
void RerouteKernel(uint3 id : SV_DispatchThreadID)
{
    uint cellIdx = PosToIdx(id.xy);

    Cell c = _Cells[cellIdx];
    if (c.cellType != CELLTYPE_WOOD || c.energyFlow > 0 || c.parentDir == 0xffffffff) return; // only wood

    SetIntBit(c.energyFlow, 1, c.parentDir);
    uint2 parentPos = ShiftCoord(id.xy, c.parentDir);
    uint parentIdx = PosToIdx(parentPos);
    SetIntBit(_Cells[parentIdx].energyFlow, 0, RotateDir(c.parentDir, 2));

    _Cells[cellIdx] = c;
}

[numthreads(32,32,1)]
void TransportKernel(uint3 id : SV_DispatchThreadID)
{
    uint2 cellPos = id.xy;
    uint cellIdx = PosToIdx(cellPos);
    Cell c = _Cells[cellIdx];
    if (c.cellType == 0 || c.cellType >=  CELLTYPE_SPROUT) return; // only wood transfers

    for (uint dir = 0; dir < 4; ++dir) {
        uint2 neighborPos = ShiftCoord(cellPos, dir);
        uint neighborIdx = PosToIdx(neighborPos);
        if (_Cells[neighborIdx].cellType == 0) continue;

        float transformDelta = GetIntBit(c.energyFlow, dir) * max(c.energy - _Cells[neighborIdx].energy, 0) * 0.02 * _Timestep;
        c.energy -= transformDelta;
        _Cells[neighborIdx].energy += transformDelta;
    }

    _Cells[cellIdx] = c;
}

[numthreads(32,32,1)]
void AbsorptionKernel(uint3 id : SV_DispatchThreadID)
{
    uint cellIdx = PosToIdx(id.xy);
    Cell c = _Cells[cellIdx];
    if (c.cellType == 0) return;

    // MVP: simple metabolic cost per tick
    float cost = 0.005 * _Timestep;
    c.energy -= cost;
    _Cells[cellIdx] = c;
}

[numthreads(32,32,1)]
void DeathKernel(uint3 id : SV_DispatchThreadID)
{
    uint cellIdx = PosToIdx(id.xy);
    Cell c = _Cells[cellIdx];
    if (c.cellType != 0
        && (c.energy <= 0.0
            || (c.cellType == CELLTYPE_ROOT && _SoilTexRead[id.xy].x <= 0)
            || (c.cellType == CELLTYPE_ANTENNA && _SoilTexRead[id.xy].y <= 0)
            || (c.cellType != CELLTYPE_ROOT && _SoilTexRead[id.xy].x > _CriticalOrg)
            || (c.cellType != CELLTYPE_ANTENNA && _SoilTexRead[id.xy].y > _CriticalNrg)
            || (c.cellType > 0 && c.cellType < CELLTYPE_SPROUT && c.energyFlow == 0 && c.parentDir == 0xffffffff)
            // || (c.cellType == CELLTYPE_WOOD && c.flowDirs = 0)
        )
    ) {
        KillCell(id.xy);
    }
}

[numthreads(32,32,1)]
void BehaviorKernel(uint3 id : SV_DispatchThreadID)
{
    uint cellIdx = PosToIdx(id.xy);
    Cell c = _Cells[cellIdx];

    if (c.cellType != CELLTYPE_SPROUT) return; // only sprouts

    ExecuteGene(id.xy, _Genomes[c.genomeId].genes[c.activeGene]);
}

[numthreads(32,32,1)]
void StatsKernel(uint3 id : SV_DispatchThreadID)
{
    uint cellIdx = PosToIdx(id.xy);
    Cell c = _Cells[cellIdx];
    // InterlockedAdd(_Stats[0], 1);
    InterlockedAdd(_Stats[0], c.cellType != 0 ? 1 : 0);
    InterlockedAdd(_Stats[1], c.cellType == CELLTYPE_LEAF ? 1 : 0);
    // _Stats[0] = totalCells;
    // _Stats[1] = leafCount;
}
